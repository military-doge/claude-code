# ============================================================
# 模型配置 —— /model 槽位（MODEL_SLOT_1 ~ MODEL_SLOT_10）全独立
# ============================================================
# 规则:
#   - MODEL_SLOT_N_MODEL        接口需要的模型名（必填；写了才显示该槽）
#   - MODEL_SLOT_N_DESCRIPTION  /model 列表里该行下方的灰字说明（可选）
#   - MODEL_SLOT_N_BASE_URL     该槽独立的接口地址（建议每个槽都显式写全）
#   - MODEL_SLOT_N_API_KEY      该槽独立的密钥；以 Authorization: Bearer 发送
#   - 槽1 = 默认启动引擎
#   - 选中某槽后其 base_url/api_key 作用于整个会话（含子代理/teammate）；
#     所选槽序号持久化到 settings.modelSlot，重启恢复到精确那个槽（同引擎多槽不串）
#   - 子代理引擎可用 CLAUDE_CODE_SUBAGENT_MODEL 单独指定
#
# 直接把下面的槽位块复制进 .env 并换成你自己的 key 即可（与当前工作配置一致）：
DISABLE_TELEMETRY=1
CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1

MODEL_SLOT_1_MODEL=deepseek-v4-pro
MODEL_SLOT_1_DESCRIPTION=slot 1 · DeepSeek v4 Pro
MODEL_SLOT_1_BASE_URL=https://api.deepseek.com/anthropic
MODEL_SLOT_1_API_KEY=sk-your_deepseek_key
MODEL_SLOT_2_MODEL=deepseek-v4-flash
MODEL_SLOT_2_DESCRIPTION=slot 2 · DeepSeek v4 Flash
MODEL_SLOT_2_BASE_URL=https://api.deepseek.com/anthropic
MODEL_SLOT_2_API_KEY=sk-your_deepseek_key
MODEL_SLOT_3_MODEL=qwen3.8-flash
MODEL_SLOT_3_DESCRIPTION=slot 3 · qwen3.8 flash
MODEL_SLOT_3_BASE_URL=https://dashscope.aliyuncs.com/apps/anthropic
MODEL_SLOT_3_API_KEY=sk-your_dashscope_key

CLAUDE_CODE_SUBAGENT_MODEL=qwen3.8-flash
CLAUDE_CODE_EFFORT_LEVEL="max"

# 提示：这是"槽全独立"模式，不依赖全局 ANTHROPIC_BASE_URL/AUTH_TOKEN。
# 若启动早期 provider 检测被误判为 first-party（报鉴权或 /model 列表不对），
# 可临时补一份全局 ANTHROPIC_BASE_URL / ANTHROPIC_AUTH_TOKEN 作兜底。
