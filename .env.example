# ============================================================
# 模型配置格式说明（服务商编号分组 + 模型跨服务商顺序编号）
# ============================================================
# 写法：每个服务商写一对 MODEL_PROVIDER_N_BASE_URL / MODEL_PROVIDER_N_API_KEY，
# 其后穿插该服务商下的模型槽；模型槽跨服务商全局顺序编号（1,2,3...），
# 按 .env 文件行序归属到前面最近的服务商块，无需额外引用字段。
#
# 字段规则:
#   - MODEL_PROVIDER_N_BASE_URL   服务商 N 的接口地址（该服务商下所有模型共用）
#   - MODEL_PROVIDER_N_API_KEY    服务商 N 的密钥；以 Authorization: Bearer 发送
#   - MODEL_SLOT_N_MODEL          接口需要的模型名（必填；写了才显示该槽）
#   - MODEL_SLOT_N_DESCRIPTION    /model 列表里该行下方的灰字说明（可选）
#   - 槽1 = 默认启动引擎；最多扫描 MODEL_SLOT_1 ~ MODEL_SLOT_10
#   - 归属关系来自 .env 文件行序：不在文件里的槽（shell export、
#     CC_HAHA_SKIP_DOTENV=1 的服务端子进程）回退全局
#     ANTHROPIC_BASE_URL / ANTHROPIC_AUTH_TOKEN
#   - 选中某槽后其 base_url/api_key 作用于整个会话（含子代理/teammate）；
#     所选槽序号持久化到 settings.modelSlot，重启恢复到精确那个槽
#   - 子代理引擎可用 CLAUDE_CODE_SUBAGENT_MODEL 单独指定
#
# 模板（按需替换成自己的服务商与模型）：
#
# MODEL_PROVIDER_1_BASE_URL=https://api.example-a.com/anthropic
# MODEL_PROVIDER_1_API_KEY=sk-你的example_a_key
# MODEL_SLOT_1_MODEL=example-a-model-pro
# MODEL_SLOT_1_DESCRIPTION=Example A Pro
# MODEL_SLOT_2_MODEL=example-a-model-flash
# MODEL_SLOT_2_DESCRIPTION=Example A Flash
#
# MODEL_PROVIDER_2_BASE_URL=https://api.example-b.com/anthropic
# MODEL_PROVIDER_2_API_KEY=sk-你的example_b_key
# MODEL_SLOT_3_MODEL=example-b-model-turbo
# MODEL_SLOT_3_DESCRIPTION=Example B Turbo

DISABLE_TELEMETRY=1
CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
